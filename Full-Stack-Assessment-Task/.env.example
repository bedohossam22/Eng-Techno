# Copy this file to .env in the repository root before starting the apps.
# Do NOT commit your actual .env file — it contains secrets.

# --- API ---
# MongoDB connection string. Use a local instance or a cloud-hosted URI.
# Example (local):  mongodb://127.0.0.1:27017/projectflow
# Example (Atlas):  mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=<app>
MONGODB_URI=mongodb://127.0.0.1:27017/projectflow

# A long, random string used to sign JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# How long JWT access tokens stay valid (e.g. 7d, 1h, 30m)
JWT_EXPIRES_IN=7d

# Port the NestJS API listens on
API_PORT=4732

# Origin the browser connects from; must match the web app URL for CORS
WEB_ORIGIN=http://localhost:3742

# --- Web ---
# The base URL the Next.js app uses to reach the API (browser-side)
NEXT_PUBLIC_API_URL=http://localhost:4732
